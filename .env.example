# Configuracao MySQL: informe cada campo separadamente.
# Informe a senha original, sem percent-encoding. Caracteres especiais são aceitos.
# SQLAlchemy escapa a senha ao montar a URL de conexão.
KEALEX_DB_HOST=db.example.internal
KEALEX_DB_PORT=3306
KEALEX_DB_NAME=kealex
KEALEX_DB_USER=kealex_app
KEALEX_DB_PASSWORD=troque-por-uma-senha-segura

# Compatibilidade temporaria para serviços antigos que ainda leem a URL completa.
# Deixe vazio quando KEALEX_DB_* estiver configurado.
KEALEX_DATABASE_URL=
