# Configuracao MySQL: informe cada campo separadamente.
# Informe a senha original, sem percent-encoding. Caracteres especiais são aceitos.
# SQLAlchemy escapa a senha ao montar a URL de conexão.
KEALEX_DB_HOST=db.example.internal
KEALEX_DB_PORT=3306
KEALEX_DB_NAME=kealex
KEALEX_DB_USER=kealex_app
KEALEX_DB_PASSWORD=troque-por-uma-senha-segura

# Compatibilidade temporaria para serviços antigos que ainda leem a URL completa.
# Deixe vazio quando KEALEX_DB_* estiver configurado.
KEALEX_DATABASE_URL=

# ASAAS: mantenha a chave entre aspas simples no arquivo .env.
# Isso preserva caracteres como $ durante a interpolacao do Docker Compose.
KEALEX_ASAAS_API_KEY='cole-sua-chave-asaas-aqui'
KEALEX_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token de validacao do webhook do ASAAS.
# Configure o mesmo valor no painel do ASAAS em: Configuracoes > Integracoes > Webhooks > Token.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
KEALEX_ASAAS_WEBHOOK_TOKEN='gere-um-token-seguro-aqui'
